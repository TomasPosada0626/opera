{
  "name": "opera",
  "private": true,
  "version": "0.0.1",
  "description": "Opera — Plataforma de Gestión Operativa Empresarial (ERP de escritorio para inventario, producción, compras y ventas).",
  "license": "MIT",
  "author": "Tomas Posada",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:deploy": "pnpm --filter backend db:deploy",
    "db:studio": "pnpm --filter backend db:studio",
    "db:seed": "pnpm --filter backend db:seed",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "@nestjs/swagger>js-yaml": "^5.2.2",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "deepmerge-ts": "^8.0.0",
      "exceljs>uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "packages/backend/**/*.ts": [
      "eslint --fix"
    ],
    "packages/desktop/**/*.{ts,tsx,mts}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
