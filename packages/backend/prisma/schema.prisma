// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Habilita declarar índices GIN/trigram directamente en el schema (ver
  // Product/Customer/Supplier más abajo) en vez de mantenerlos como SQL
  // crudo fuera del control de `prisma migrate` — sigue siendo preview en
  // Prisma 6, pero estable y ampliamente usado; no tiene relación con la
  // migración a Prisma 7 (issue #104), que sigue pendiente aparte.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  isActive          Boolean            @default(true)
  roles             UserRole[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]
  productionOrders  ProductionOrder[]
  orders            Order[]
  remissions        Remission[]
  supplierPurchases SupplierPurchase[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  name      String           @unique
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Tabla de unión explícita en vez de la m:n implícita de Prisma: nombre legible
// en Postgres y espacio para extenderla después sin una migración destructiva.
model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Ledger append-only: cada acción relevante sobre una entidad queda registrada
// aquí con su estado anterior y posterior. No se edita ni se borra.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// El stock por producto se calcula por bodega (StockMovement.warehouseId,
// ver #18), nunca global — una misma referencia puede tener existencias
// distintas en cada bodega. Ubicación granular (pasillo/estante) queda como
// campo libre en StockMovement, no como jerarquía propia bajo Warehouse.
model Warehouse {
  id                String             @id @default(uuid())
  name              String             @unique
  location          String?
  isActive          Boolean            @default(true)
  stockMovements    StockMovement[]
  productionOrders  ProductionOrder[]
  orders            Order[]
  supplierPurchases SupplierPurchase[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Unit {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String    @unique
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  SUPPLY
}

// Catálogo único para todo lo que se mueve por Kardex: productos terminados,
// materias primas e insumos son Product con distinto `type`, no tablas
// separadas — StockMovement (#18) referencia un solo productId. RawMaterial
// (#28, M3) y BillOfMaterials (#29) se apoyan en este mismo catálogo en vez
// de duplicar "un ítem con nombre, unidad y stock" en una tabla paralela.
model Product {
  id                String                @id @default(uuid())
  sku               String                @unique
  name              String
  type              ProductType
  categoryId        String
  category          Category              @relation(fields: [categoryId], references: [id])
  unitId            String
  unit              Unit                  @relation(fields: [unitId], references: [id])
  // Umbrales de alerta (#67); null = sin umbral configurado, no "alertar en 0".
  minStock          Decimal?              @db.Decimal(12, 3)
  maxStock          Decimal?              @db.Decimal(12, 3)
  // Texto libre, sin catálogo fijo (mismo patrón que Warehouse.location) —
  // distinguen variantes del mismo producto base (ej. una silla en roble
  // natural vs. una en pino oscuro) al armar un pedido rápido.
  finish            String?
  material          String?
  size              String?
  isActive          Boolean               @default(true)
  stockMovements    StockMovement[]
  // La receta que ESTE producto produce (type debe ser FINISHED_GOOD,
  // validado en el service — Prisma no expresa constraints condicionales
  // sobre un enum) y las líneas donde este producto se consume como insumo
  // de otra receta — son relaciones distintas al mismo modelo Product, cada
  // una necesita su propio nombre.
  recipe            BillOfMaterials?      @relation("ProductRecipe")
  usedAsComponentIn BillOfMaterialsItem[] @relation("ProductComponent")
  productionOrders  ProductionOrder[]
  orderItems        OrderItem[]
  supplierProducts  SupplierProduct[]
  supplierPurchases SupplierPurchase[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([categoryId])
  @@index([unitId])
  // GIN/trigram: search.service.ts y products.service.ts buscan estos 5
  // campos con `contains`/ILIKE — sin esto es un scan secuencial que
  // degrada linealmente con el catálogo (señalado en la auditoría de
  // escalabilidad). btree normal no sirve para "contiene", por eso GIN.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([finish(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([material(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([size(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

// Ledger append-only (ver ADR #19): jamás se edita ni se borra un movimiento.
// El stock actual (#24) es SUM(quantity) por (productId, warehouseId) — nunca
// un campo que se sobreescribe. quantity guarda el delta CON SIGNO: ENTRADA
// positivo, SALIDA negativo, AJUSTE cualquiera — así el cálculo de stock es
// una simple suma, no un switch por tipo. Ubicación granular (pasillo/estante)
// vive aquí como campo libre, no como jerarquía bajo Warehouse (ver #64).
model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  // Costo unitario absoluto (nunca con signo, a diferencia de quantity) al
  // momento de este movimiento — ver ADR 0002. En ENTRADA es el costo
  // declarado al recibir (opcional); en SALIDA/AJUSTE es el promedio
  // ponderado vigente al consumir, calculado y grabado por quien escribe el
  // movimiento (#34), nunca recalculado después — el movimiento ya escrito
  // no cambia, igual que quantity.
  unitCost    Decimal?          @db.Decimal(14, 4)
  reason      String?
  location    String?
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  // Inverso de SupplierPurchase.stockMovementId — trazabilidad de "esta
  // ENTRADA vino de recibir esta compra registrada", sin volver el flujo
  // normal de Inventario obligatorio a tener una compra detrás.
  supplierPurchase SupplierPurchase?

  // Compuesto con createdAt al final: cubre tanto el filtro
  // (productId, warehouseId) como el ORDER BY createdAt que getAverageCost()
  // y getKardex() ya hacían sobre ese mismo filtro (antes forzaba un
  // filesort aparte, señalado en la auditoría) — reemplaza al índice de
  // solo 2 columnas que había antes, que quedaba como un prefijo redundante
  // de este.
  @@index([productId, warehouseId, createdAt])
  @@index([warehouseId])
}

// Receta de un producto terminado: qué materiales (y cuánto de cada uno) se
// consumen para producir 1 unidad. Una sola receta activa por producto (no
// versionada/histórica) — si eso cambia, la orden de producción (#30) que ya
// se completó no necesita "recordar" qué receta se usó porque su consumo
// real ya quedó grabado como StockMovement, que es el ledger que importa.
model BillOfMaterials {
  id        String                @id @default(uuid())
  productId String                @unique
  product   Product               @relation("ProductRecipe", fields: [productId], references: [id])
  isActive  Boolean               @default(true)
  items     BillOfMaterialsItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

// componentId normalmente será un Product con type RAW_MATERIAL o SUPPLY
// (validado en el service, no en el schema — Prisma no expresa constraints
// condicionales sobre un enum de otra tabla).
model BillOfMaterialsItem {
  id                String          @id @default(uuid())
  billOfMaterialsId String
  billOfMaterials   BillOfMaterials @relation(fields: [billOfMaterialsId], references: [id], onDelete: Cascade)
  componentId       String
  component         Product         @relation("ProductComponent", fields: [componentId], references: [id])
  // Cantidad de componentId requerida para producir 1 unidad del producto
  // terminado de la receta — la unidad de medida ya la define component.unitId.
  quantity          Decimal         @db.Decimal(12, 3)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([billOfMaterialsId, componentId])
}

// EN_PROCESO existió en el enum original sin que ningún código lo
// asignara (#98, auditoría de huecos 2026-08-22) — la orden salta directo
// de PENDIENTE a COMPLETADA porque no hay un punto real del negocio que
// marque "empezó a procesarse": a diferencia de Order.EN_PRODUCCION (una
// bandera manual para contar días reales que un pedido pasa en el taller),
// acá no hay consumo parcial que trackear ni un hito intermedio distinto
// de "se declaró la intención" (create) y "se consumió y produjo"
// (complete) — agregar un estado intermedio sería inventar un paso que
// nadie dispara. Retirado; CANCELADA reemplaza el valor muerto para #98.
enum ProductionOrderStatus {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

// Una orden declara "quiero producir N unidades de este producto terminado"
// en una bodega. Crearla (#32) valida que haya suficiente stock de cada
// componente de la receta × N. Completarla (#33) genera los StockMovement
// reales (SALIDA por cada componente consumido, ENTRADA del terminado) — la
// orden en sí es solo la intención + su estado, StockMovement sigue siendo
// la única fuente de verdad de qué se movió (igual que con BillOfMaterials).
// Cancelarla (#98) no revierte nada — crear la orden nunca escribió
// StockMovement (solo lo valida como informativo), así que solo hay un
// campo de estado que cambiar, y únicamente mientras siga PENDIENTE.
model ProductionOrder {
  id          String                @id @default(uuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  quantity    Decimal               @db.Decimal(12, 3)
  status      ProductionOrderStatus @default(PENDIENTE)
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  completedAt DateTime?
  // Calculados una sola vez al completar (#34, ver ADR 0002) y nunca
  // recalculados después — null mientras la orden sigue PENDIENTE.
  // totalCost = suma del costo consumido de cada componente (promedio
  // ponderado vigente al completar × cantidad consumida); unitCost =
  // totalCost / quantity, el costo del producto terminado producido.
  totalCost   Decimal?              @db.Decimal(14, 4)
  unitCost    Decimal?              @db.Decimal(14, 4)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
}

// Empieza M5. Customer y Supplier son modelos separados, no un Party
// unificado con un flag isCustomer/isSupplier: sus relaciones downstream
// divergen desde el día uno (Customer -> Order/Remission/Payment #50-52/72,
// Supplier -> PurchaseOrder #68-70) y una empresa que es cliente Y
// proveedor a la vez es una fila en cada tabla, no un caso especial de una
// sola. taxId es @unique pero nullable a propósito: Postgres no choca dos
// NULL entre sí, así que sigue evitando duplicados por NIT/RUT cuando el
// dato existe, sin exigirlo en clientes/proveedores informales que no lo
// tengan a mano al crearlos. Historial de pedidos/última compra (pedido en
// la nota de visión de M5) no vive aquí como campo — se deriva de Order
// (#50) cuando exista, igual que el stock se deriva de StockMovement.
model Customer {
  id        String   @id @default(uuid())
  name      String
  taxId     String?  @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ver el mismo comentario en Product — búsqueda ILIKE por nombre en
  // customers.service.ts y search.service.ts.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Supplier {
  id               String             @id @default(uuid())
  name             String
  taxId            String?            @unique
  email            String?
  phone            String?
  address          String?
  isActive         Boolean            @default(true)
  supplierProducts SupplierProduct[]
  purchases        SupplierPurchase[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Ver el mismo comentario en Product — búsqueda ILIKE por nombre en
  // suppliers.service.ts y search.service.ts.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Precio vigente de un producto para un proveedor — no versionado/histórico
// a propósito, se sobreescribe al editar (mismo espíritu que BillOfMaterials
// no versiona recetas: lo que importa es "cuánto cuesta hoy", no un
// histórico de precios). Desconectado de PurchaseOrder (#68, todavía sin
// construir): es la lista de precios de referencia del proveedor, no una
// cotización ligada a una compra puntual.
model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  price      Decimal  @db.Decimal(14, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, productId])
}

// Bitácora manual de compras — "qué se pidió, a quién, cuándo, qué costó",
// para seguimiento de gasto por proveedor. Desconectada de StockMovement a
// propósito (decisión del negocio, no una limitación técnica): la entrada
// real de materia prima al almacén sigue siendo un movimiento manual de
// Inventario aparte, así que nada aquí reconcilia automáticamente "lo
// pedido a un proveedor" contra "lo que de verdad entró al stock" — es una
// limitación conocida y aceptada, no un hueco a cerrar en esta fase.
model SupplierPurchase {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  unitCost    Decimal  @db.Decimal(14, 4)
  purchasedAt DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  // Reconciliación (#104-purchases): nulo = registros históricos de antes
  // de este campo, que nunca podrán "recibirse" — no tiene sentido
  // reconciliar una compra ya vieja sin bodega declarada. Para compras
  // nuevas el DTO exige warehouseId, así que en la práctica siempre viene.
  warehouseId     String?
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id])
  // Marca de hito, mismo patrón que Order.warehousedAt/ProductionOrder.completedAt
  // — nulo = pendiente de recibir. `receive()` la fija atómicamente junto con
  // stockMovementId, así que nunca hay una compra "recibida" sin su
  // ENTRADA real, ni al revés.
  receivedAt      DateTime?
  stockMovementId String?        @unique
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id])

  @@index([supplierId])
  @@index([productId])
}

enum OrderStatus {
  PENDIENTE
  EN_PRODUCCION
  EN_ALMACEN
  CANCELADO
}

// Un pedido de venta es la intención del cliente — qué productos, cuánta
// cantidad, a qué precio. A diferencia del diseño original (#50/#51), este
// negocio fabrica sobre pedido: no hay stock de terminado esperando venta,
// así que crear el pedido NO mueve inventario — el stock del terminado
// nace cuando de verdad existe. El ciclo real: PENDIENTE (creado, nada se
// mueve) -> EN_PRODUCCION (bandera manual con timestamp para contar días,
// sin consumo de materiales por receta — imposible de calcular de forma
// confiable por la variación entre pedidos y la pérdida de material) ->
// EN_ALMACEN (el terminado entra al stock de verdad, ENTRADA por línea).
// El descuento de stock por venta vive en Remission, no aquí — ver su
// comentario. warehouseId sigue siendo una sola bodega por pedido, mismo
// patrón que ProductionOrder.
model Order {
  id                  String      @id @default(uuid())
  customerId          String
  customer            Customer    @relation(fields: [customerId], references: [id])
  warehouseId         String
  warehouse           Warehouse   @relation(fields: [warehouseId], references: [id])
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  status              OrderStatus @default(PENDIENTE)
  // Se fijan al transicionar (mark-production / mark-warehoused), nunca se
  // recalculan — mismo espíritu que ProductionOrder.completedAt: son la
  // marca de cuándo ocurrió el hito, no un valor derivable de otra parte.
  productionStartedAt DateTime?
  warehousedAt        DateTime?
  items               OrderItem[]
  remissions          Remission[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
}

// unitPrice se captura explícito por línea al crear el pedido (#51) — no
// existe una lista de precios por producto todavía (Product no tiene campo
// de precio, solo StockMovement.unitCost para costeo interno), así que no
// hay de dónde "derivarlo": es dato de negocio del momento, mismo patrón
// que StockMovement.unitCost. Sin @@unique([orderId, productId]) a
// propósito — un mismo producto puede aparecer en dos líneas del mismo
// pedido con precios distintos (p. ej. un lote a precio de lista y otro
// con descuento negociado), a diferencia de BillOfMaterialsItem donde un
// componente repetido en la misma receta no tendría sentido de negocio.
// El total del pedido NO se guarda como campo propio — se deriva de
// SUM(quantity * unitPrice) de estas líneas cuando se necesite, mismo
// espíritu que el stock derivándose de StockMovement en vez de un número
// que alguien pueda desincronizar.
model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  quantity       Decimal         @db.Decimal(12, 3)
  unitPrice      Decimal         @db.Decimal(14, 4)
  remissionItems RemissionItem[]
  createdAt      DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

enum RemissionPaymentStatus {
  PAGADO
  ABONADO
  CARTERA
}

// La remisión es el documento de entrega en sí — crearla ES el hecho de
// despachar. Un pedido puede despacharse en varios envíos parciales;
// "cuánto se ha entregado" se sigue derivando de SUM(RemissionItem.quantity)
// agrupado por orderItemId, nunca un campo propio. A diferencia del diseño
// original (#52/#53), crear la remisión SÍ mueve StockMovement (SALIDA por
// línea) — el pedido ya no descuenta nada al crearse (ver comentario de
// Order), así que el descuento real por venta vive aquí, en el momento en
// que la mercancía de verdad sale del almacén.
// paymentStatus/amountPaid: el estado de pago se confirma normalmente
// después del despacho, no necesariamente al momento de crear la remisión
// — por eso son editables después (PATCH /remissions/:id/payment), no solo
// capturables una vez. Es dato interno del negocio: el PDF/impresión de la
// remisión (lo que ve el cliente) nunca lo incluye.
// number es el consecutivo del documento (numeración de remisiones, uso
// típico en la práctica comercial) — autoincremental porque un UUID no
// sirve para un número que un humano necesita leer/citar en papel.
model Remission {
  id            String                 @id @default(uuid())
  number        Int                    @unique @default(autoincrement())
  orderId       String
  order         Order                  @relation(fields: [orderId], references: [id])
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  paymentStatus RemissionPaymentStatus @default(CARTERA)
  // Solo tiene sentido cuando paymentStatus = ABONADO — cuánto de esta
  // remisión ya se pagó, no el saldo total del cliente (eso es un cálculo
  // aparte, fuera de alcance de este modelo).
  amountPaid    Decimal?               @db.Decimal(14, 4)
  // Corregir una remisión con cantidad equivocada (#99) no edita ni borra
  // la fila (ni ella ni el StockMovement que generó son editables — mismo
  // espíritu append-only que el Kardex, ADR 0001): se "anula", la fila
  // queda con el motivo, y se escribe una ENTRADA de reverso por cada
  // línea para corregir el stock. "Cuánto se ha entregado"
  // (SUM(RemissionItem.quantity), ver RemissionsService.create) excluye
  // remisiones anuladas, así que el pedido vuelve a admitir un despacho
  // correcto por esa cantidad.
  voidedAt      DateTime?
  voidReason    String?
  items         RemissionItem[]
  createdAt     DateTime               @default(now())

  @@index([orderId])
}

// orderItemId (no productId suelto) — la cantidad entregada se rastrea
// contra la línea específica del pedido que la originó, no solo contra el
// producto: un pedido puede tener dos líneas del mismo producto a precios
// distintos (ver OrderItem), y "cuánto falta por entregar" solo tiene
// sentido por línea, no agregado por producto. Que SUM(quantity) de las
// líneas de todas las remisiones de un orderItemId no exceda
// OrderItem.quantity es responsabilidad del service que las cree (#53) —
// Prisma no puede expresar esa restricción entre tablas en el schema.
model RemissionItem {
  id          String    @id @default(uuid())
  remissionId String
  remission   Remission @relation(fields: [remissionId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
  createdAt   DateTime  @default(now())

  @@index([remissionId])
  @@index([orderItemId])
}
