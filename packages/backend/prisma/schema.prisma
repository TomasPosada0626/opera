// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  isActive       Boolean         @default(true)
  roles          UserRole[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  name      String           @unique
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Tabla de unión explícita en vez de la m:n implícita de Prisma: nombre legible
// en Postgres y espacio para extenderla después sin una migración destructiva.
model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Ledger append-only: cada acción relevante sobre una entidad queda registrada
// aquí con su estado anterior y posterior. No se edita ni se borra.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// El stock por producto se calcula por bodega (StockMovement.warehouseId,
// ver #18), nunca global — una misma referencia puede tener existencias
// distintas en cada bodega. Ubicación granular (pasillo/estante) queda como
// campo libre en StockMovement, no como jerarquía propia bajo Warehouse.
model Warehouse {
  id             String          @id @default(uuid())
  name           String          @unique
  location       String?
  isActive       Boolean         @default(true)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Unit {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String    @unique
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  SUPPLY
}

// Catálogo único para todo lo que se mueve por Kardex: productos terminados,
// materias primas e insumos son Product con distinto `type`, no tablas
// separadas — StockMovement (#18) referencia un solo productId. RawMaterial
// (#28, M3) y BillOfMaterials (#29) se apoyan en este mismo catálogo en vez
// de duplicar "un ítem con nombre, unidad y stock" en una tabla paralela.
model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  type           ProductType
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id])
  // Umbrales de alerta (#67); null = sin umbral configurado, no "alertar en 0".
  minStock       Decimal?        @db.Decimal(12, 3)
  maxStock       Decimal?        @db.Decimal(12, 3)
  isActive       Boolean         @default(true)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([unitId])
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

// Ledger append-only (ver ADR #19): jamás se edita ni se borra un movimiento.
// El stock actual (#24) es SUM(quantity) por (productId, warehouseId) — nunca
// un campo que se sobreescribe. quantity guarda el delta CON SIGNO: ENTRADA
// positivo, SALIDA negativo, AJUSTE cualquiera — así el cálculo de stock es
// una simple suma, no un switch por tipo. Ubicación granular (pasillo/estante)
// vive aquí como campo libre, no como jerarquía bajo Warehouse (ver #64).
model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  reason      String?
  location    String?
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([productId, warehouseId])
  @@index([warehouseId])
}
