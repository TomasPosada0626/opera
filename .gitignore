# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
build/
coverage/
*.tsbuildinfo

# electron-builder lee sus recursos de empaquetado (icono) de
# packages/desktop/build/ — no es un directorio de output, así que la regla
# genérica de arriba no debe taparlo (#46).
!packages/desktop/build/
!packages/desktop/build/**

# Env
.env
.env.local
.env.*.local

# Playwright (#57)
playwright-report/
test-results/
packages/backend/e2e-fixtures/.state*.json
packages/backend/load-tests/.dataset.json

# Export generado por scripts/archive-audit-log.ts (ADR 0006) — datos reales
# de una instalación puntual, nunca material para commitear al repo.
packages/backend/scripts/*.jsonl

# Respaldos generados por scripts/backup-db.ts — datos reales de negocio,
# nunca material para commitear al repo.
/backups/

# Certificado de firma de código (generate-self-signed-cert.ps1) — la
# clave privada nunca se commitea, cada máquina de build genera la suya.
packages/desktop/certs/

# Logs
packages/backend/logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
packages/backend/prisma/*.db

# Nota de continuidad entre sesiones de trabajo con el asistente — no es
# documentación del proyecto (eso vive en README.md/docs/adr), es solo
# "dónde íbamos" para la próxima sesión.
/NEXT_SESSION.md
