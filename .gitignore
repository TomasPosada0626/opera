# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
build/
coverage/
*.tsbuildinfo

# electron-builder lee sus recursos de empaquetado (icono) de
# packages/desktop/build/ — no es un directorio de output, así que la regla
# genérica de arriba no debe taparlo (#46).
!packages/desktop/build/
!packages/desktop/build/**

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
packages/backend/prisma/*.db
