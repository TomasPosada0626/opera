# Copia este archivo a .env y ajusta los valores para tu entorno local.
# .env nunca se commitea (ver .gitignore).

# --- PostgreSQL (usado por docker-compose.yml) ---
POSTGRES_USER=opera
POSTGRES_PASSWORD=opera
POSTGRES_DB=opera
POSTGRES_PORT=5432

# --- Backend (NestJS) ---
# Cadena de conexión que usará Prisma (packages/backend). `connection_limit`
# explícito en vez de confiar en el default de Prisma (num_cpus*2+1, variable
# según la máquina): las operaciones bajo Serializable (markWarehoused,
# production.complete) necesitan varias conexiones simultáneas disponibles
# para que la contención real del pool no termine pareciendo un bug de
# concurrencia — un pool demasiado chico fue justamente la causa raíz del
# fallo de CI que este mismo endurecimiento de sesión corrigió. 10 alcanza
# de sobra para una sola instancia del backend en LAN con un solo usuario
# Administrador; subirlo no ayuda si Postgres mismo tiene menos que eso
# disponible (`max_connections`, default 100 en postgres:16).
DATABASE_URL="postgresql://opera:opera@localhost:5432/opera?schema=public&connection_limit=10&pool_timeout=20"
PORT=3000

# Docs interactivos en /docs (Swagger/OpenAPI). Apagado por defecto: es
# conveniencia de desarrollo local, nunca se debe activar en un despliegue
# real de LAN (expondría el esquema completo de la API sin autenticación).
SWAGGER_ENABLED=true

# Genera un valor propio, por ejemplo: openssl rand -base64 32
JWT_SECRET=changeme-generate-a-strong-secret
JWT_EXPIRES_IN=1d

# Límite global de requests/minuto por IP (ver ThrottlerModule en
# app.module.ts). Déjalo sin definir en producción (default 100) — solo se
# sube para correr packages/backend/load-tests/ localmente, donde k6 disparó
# más tráfico del que el techo real permitiría medir.
# RATE_LIMIT_PER_MINUTE=100000

# Límite de POST /auth/login por IP (ver auth.controller.ts), aparte del
# global de arriba. Déjalo sin definir en producción (default 5/min) — solo
# se sube para correr packages/desktop/e2e/*.spec.ts (Playwright) donde
# varios specs independientes hacen login real de verdad contra el mismo
# backend en la misma corrida; el total agregado puede superar 5/min según
# cuántos specs corran, sin que ninguno individualmente abuse del endpoint.
# AUTH_LOGIN_RATE_LIMIT=30

# --- Seed: usuario Administrador inicial (pnpm db:seed) ---
ADMIN_EMAIL=admin@opera.local
ADMIN_PASSWORD=changeme-strong-admin-password

# --- SMTP: "olvidé mi contraseña" (código de verificación por correo) ---
# Todas opcionales -- sin esto, /auth/forgot-password sigue respondiendo
# 200 (nunca revela si un correo existe) pero no manda ningún correo real;
# queda un warning en el log. Cualquier proveedor SMTP sirve (Gmail,
# Outlook, Zoho, un servidor propio...). Con Gmail: activa verificación en
# dos pasos en esa cuenta y genera una "contraseña de aplicación" -- la
# contraseña normal de la cuenta no funciona como SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@tuempresa.com
# SMTP_PASSWORD=changeme-app-password
# SMTP_FROM="Opera <notificaciones@tuempresa.com>"
